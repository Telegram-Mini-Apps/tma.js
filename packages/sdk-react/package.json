{
  "name": "@tma.js/sdk-react",
  "version": "3.0.24",
  "description": "React bindings for the Telegram Mini Apps SDK.",
  "author": "Vladislav Kibenko <wolfram.deus@gmail.com>",
  "homepage": "https://github.com/Telegram-Mini-Apps/tma.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Telegram-Mini-Apps/tma.js.git",
    "directory": "packages/sdk-react"
  },
  "bugs": {
    "url": "https://github.com/Telegram-Mini-Apps/tma.js/issues"
  },
  "keywords": [
    "telegram-mini-apps",
    "typescript",
    "sdk",
    "react"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/dts/index.d.ts",
  "exports": {
    ".": {
      "@tma.js/source": "./src/index.ts",
      "types": "./dist/dts/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "vitest --run",
    "lint": "eslint src",
    "lint:fix": "pnpm run lint --fix",
    "typecheck": "tsc --noEmit",
    "build": "rimraf dist && vite build"
  },
  "dependencies": {
    "@tma.js/sdk": "workspace:^"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "happy-dom": "^20.0.5",
    "tsconfig": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
