{
  "name": "@tma.js/sdk-solid",
  "version": "4.0.0-rc.1",
  "description": "Solid bindings for the Telegram Mini Apps SDK.",
  "author": "Vladislav Kibenko <wolfram.deus@gmail.com>",
  "homepage": "https://github.com/Telegram-Mini-Apps/tma.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Telegram-Mini-Apps/tma.js.git",
    "directory": "packages/sdk-solid"
  },
  "bugs": {
    "url": "https://github.com/Telegram-Mini-Apps/tma.js/issues"
  },
  "keywords": [
    "telegram-mini-apps",
    "typescript",
    "sdk",
    "solidjs"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/dts/index.d.ts",
  "exports": {
    ".": {
      "@tma.js/source": "./src/index.ts",
      "types": "./dist/dts/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "vitest --run",
    "lint": "eslint src",
    "lint:fix": "pnpm run lint --fix",
    "typecheck": "tsc --noEmit",
    "build": "rimraf dist && vite build"
  },
  "peerDependencies": {
    "@tma.js/sdk": "workspace:^",
    "solid-js": "^1.0.0"
  },
  "devDependencies": {
    "@tma.js/sdk": "workspace:^",
    "solid-js": "^1.9.3",
    "happy-dom": "^20.0.5",
    "tsconfig": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
